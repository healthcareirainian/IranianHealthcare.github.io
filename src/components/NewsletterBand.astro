---
import { url } from '../lib/utils';
---

<section class="nl-band" aria-labelledby="nl-title">
  <div class="wrap nl-row">
    <div>
      <h2 id="nl-title">روز خود را با «سلامت ایران» شروع کنید</h2>
      <p>خلاصه مهم‌ترین اخبار و دانستنی‌های نظام سلامت، هر هفته در صندوق ایمیل یا تلگرام شما.</p>
    </div>
    <a class="btn" href={url('/newsletters/')}>عضویت در خبرنامه</a>
  </div>
</section>

<style>
  .nl-band {
    background: var(--navy-2);
    color: #fff;
    padding-block: 28px;
    margin-block: 40px;
  }
  .nl-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
  }
  h2 {
    color: #fff;
    font-size: 1.45rem;
  }
  p {
    margin: 6px 0 0;
    color: #d6e0f0;
  }
</style>
