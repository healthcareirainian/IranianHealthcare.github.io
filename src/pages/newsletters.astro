---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { url } from '../lib/utils';

const letters = [
  { title: 'سلامت ایران: هفتگی', text: 'مهم‌ترین مطالب هفته در همه بخش‌ها، هر شنبه.' },
  { title: 'فناوری سلامت', text: 'هوش مصنوعی، سلامت دیجیتال و پرونده الکترونیک سلامت.' },
  { title: 'بالینی و دارو', text: 'راهنماهای بالینی، کنترل عفونت و مصرف منطقی دارو.' },
  { title: 'دندانپزشکی', text: 'سلامت دهان و فناوری‌های نوین دندانپزشکی.' },
];
---

<BaseLayout title="خبرنامه‌ها" description="عضویت در خبرنامه‌های سلامت ایران.">
  <div class="wrap nl">
    <h1>خبرنامه‌ها</h1>
    <p class="lede">
      خبرنامه‌های سلامت ایران به‌زودی راه‌اندازی می‌شوند. تا آن زمان می‌توانید مطالب تازه را از طریق
      <a href={url('/rss.xml')}>خوراک RSS</a>{site.telegram && <> یا <a href={site.telegram}>کانال تلگرام</a></>} دنبال کنید.
    </p>
    <div class="grid">
      {letters.map((l) => (
        <div class="panel">
          <h2>{l.title}</h2>
          <p>{l.text}</p>
          <button class="btn" type="button" disabled aria-disabled="true">به‌زودی</button>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .nl {
    padding-block: 32px;
  }
  h1 {
    font-size: 2rem;
  }
  .lede {
    color: var(--ink-2);
    max-width: 720px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 16px;
    margin-block-start: 20px;
  }
  h2 {
    font-family: var(--font-sans);
    font-size: 1.1rem;
    font-weight: 800;
  }
  .panel p {
    color: var(--ink-2);
    font-size: 0.92rem;
  }
  .btn[disabled] {
    opacity: 0.55;
    cursor: not-allowed;
  }
</style>
