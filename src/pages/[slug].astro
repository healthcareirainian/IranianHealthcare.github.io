---
// Static pages (about, editorial policy, disclaimer, privacy, contact) from src/content/pages.
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

export const getStaticPaths = (async () => {
  const pages = await getCollection('pages');
  return pages.map((page) => ({ params: { slug: page.id }, props: { page } }));
}) satisfies GetStaticPaths;

const { page } = Astro.props as { page: CollectionEntry<'pages'> };
const { Content } = await render(page);
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <article class="wrap static">
    <h1>{page.data.title}</h1>
    <div class="prose"><Content /></div>
  </article>
</BaseLayout>

<style>
  .static {
    max-width: 800px;
    padding-block: 32px;
  }
  h1 {
    font-size: clamp(1.7rem, 4vw, 2.3rem);
    border-block-end: 2px solid var(--accent);
    padding-block-end: 8px;
  }
  .prose {
    font-size: 1.05rem;
    line-height: 2;
  }
  .prose :global(h2) {
    font-size: 1.35rem;
    margin-block: 24px 6px;
  }
</style>
